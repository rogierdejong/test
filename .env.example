# ── Markt / regio ───────────────────────────────────────────────────
# Kopieer dit bestand naar .env en pas aan waar nodig.
# Zonder .env draait alles al op de Nederlandse instellingen hieronder.

# Preset: NL, BE, DE, FR of US
TESLA_REGION=NL

# Zoeklocatie. Postcode zoals op tesla.com/nl_NL (bv. 1012AB).
TESLA_POSTAL_CODE=1012AB

# Zoekstraal in km. 0 = heel Nederland.
TESLA_RADIUS=0

# Coordinaten waar Tesla de afstand vanaf rekent (standaard Amsterdam).
# Pas aan naar je eigen woonplaats voor realistische afstandssortering.
# TESLA_LAT=52.3676
# TESLA_LNG=4.9041

# Alleen nodig als Tesla de API-parameters wijzigt:
# TESLA_MARKET=NL
# TESLA_LANGUAGE=nl
# TESLA_SUPER_REGION=europe
# TESLA_API_REGION=NL
# TESLA_LOCALE=nl_NL
# TESLA_API_LOCALE_PREFIX=

# Pad naar Chrome, als nodriver hem niet zelf vindt. Voorbeelden:
#   macOS : /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux : /usr/bin/google-chrome
# TESLA_CHROME_PATH=

# ── PostgreSQL (optioneel) ──────────────────────────────────────────
# Alleen nodig voor save_to_postgres / storage mode "postgres" of "both".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=tesla
POSTGRES_PASSWORD=

# ── Wachter: melding bij een nieuwe match ───────────────────────────
# Gebruikt door ./watch.sh en ./install-watch.sh.

# Push naar je telefoon via ntfy.sh. Kies een naam die niemand kan raden —
# wie het topic kent, kan de meldingen meelezen. Installeer de ntfy-app en
# abonneer je op hetzelfde topic.
# NTFY_TOPIC=tesla-nl-verzin-iets-uniek

# WATCH_MODEL en WATCH_CONDITION bepalen wát er gevolgd wordt: alles wat daar
# nieuw in verschijnt levert een melding op, ongeacht de specs. De rest zijn
# jouw eisen; elke melding bevat het actuele lijstje dat daaraan voldoet.
WATCH_MODEL=my
WATCH_CONDITION=used
WATCH_YEAR_MIN=2023
WATCH_YEAR_MAX=2023
WATCH_REQUIRE_TOW=1
WATCH_EXCLUDE_PAINT=WHITE
# WATCH_MAX_PRICE=40000
# WATCH_ODOMETER_MAX=60000
